{
  "name": "pi-repo-check",
  "type": "module",
  "version": "0.1.0",
  "description": "Read-only repo hygiene checks for pi, with a bundled runner and an optional REPO_CHECK_SCRIPT override.",
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "check": "npm test && node scripts/check-repo.mjs"
  },
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pfgoriaux/pi-repo-check.git"
  },
  "pi": {
    "extensions": [
      "./extensions/repo-check.ts"
    ]
  },
  "peerDependencies": {
    "typebox": "*"
  }
}
